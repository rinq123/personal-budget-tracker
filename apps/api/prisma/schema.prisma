// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a freeostgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum CategoryType {
  INCOME
  EXPENSE
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  passwordHash  String
  firstName     String
  categories    Category[]
  transactions  Transaction[]
  fixedPayments FixedPayment[]
  budgets       Budget[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Category {
  id            String         @id @default(cuid())
  name          String
  type          CategoryType
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions  Transaction[]
  fixedPayments FixedPayment[]
  budgets       Budget[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([userId, name, type])
  @@index([userId])
}

model Transaction {
  id          String          @id @default(cuid())
  description String
  amountMinor Int
  type        TransactionType
  date        DateTime
  userId      String
  categoryId  String?
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([userId, date])
  @@index([categoryId])
}

model FixedPayment {
  id          String          @id @default(cuid())
  name        String
  amountMinor Int
  type        TransactionType
  dueDay      Int?
  userId      String
  categoryId  String?
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([userId, type])
  @@index([categoryId])
}

model Budget {
  id          String   @id @default(cuid())
  amountMinor Int
  month       Int
  year        Int
  userId      String
  categoryId  String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, categoryId, month, year])
  @@index([userId, year, month])
  @@index([categoryId])
}
